# OpenEMS PCB Studio - systemd user service TEMPLATE.
#
# Do not install this file directly: the @PLACEHOLDERS@ below are filled
# in with the real paths by
#
#     scripts/install-service.sh
#
# To install by hand instead, replace @REPO@ with the absolute path of
# this repository and @PYTHON@ with your python3, then:
#
#     mkdir -p ~/.config/systemd/user
#     cp openems-webgui.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now openems-webgui
#     loginctl enable-linger $USER      # keep running while logged out
#
# Logs: journalctl --user -u openems-webgui -f

[Unit]
Description=OpenEMS PCB Studio (Flask + openEMS run sequencing)
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=PORT=@PORT@
ExecStart=@PYTHON@ @REPO@/server.py
Restart=on-failure
RestartSec=3
# a simulation may run for hours - never hard-kill mid-run on stop
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
